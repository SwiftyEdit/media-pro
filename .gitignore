# OS
.DS_Store
Thumbs.db

# IDEs / editors
.idea/
.vscode/
*.iml

# Composer dependencies (tinify/tinify - this plugin's own dependency,
# not provided by SwiftyEdit core; run `composer install --no-dev` before
# packaging a release zip)
/vendor/

# Runtime database (created on first install; /data/ itself must stay
# so PDO has a directory to write mediapro.sqlite3 into)
/data/*.sqlite3
/data/*.sqlite

# TinyPNG API key - written at runtime via the settings screen (backend/
# settings.php), contains a live secret, must never be committed
/data/apikey.php

# Release build artifacts (attach to GitHub Releases instead of committing)
/*.zip

# Logs
*.log
